<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.gnet-utility" path="/org/gnome/shell/extensions/gnet-utility/">

    <!-- Appearance -->
    <key name="theme" type="s">
      <default>"bare-text"</default>
      <summary>Theme</summary>
    </key>
    <key name="alignment" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
      <default>"auto"</default>
      <summary>Text alignment (auto follows the theme)</summary>
    </key>
    <key name="widget-width" type="i">
      <range min="240" max="520"/>
      <default>330</default>
      <summary>Widget width in pixels</summary>
    </key>
    <key name="font-scale" type="i">
      <range min="70" max="160"/>
      <default>100</default>
      <summary>Font size, percent</summary>
    </key>
    <key name="background-strength" type="i">
      <range min="0" max="150"/>
      <default>100</default>
      <summary>Card background opacity, percent of the theme default</summary>
    </key>
    <key name="corner-radius" type="i">
      <range min="0" max="40"/>
      <default>0</default>
      <summary>Card corner radius in pixels</summary>
    </key>
    <key name="card-shadow" type="b"><default>false</default><summary>Draw a drop shadow behind the card</summary></key>
    <key name="card-border" type="b"><default>true</default><summary>Draw a thin border around the card</summary></key>
    <key name="text-shadow" type="b"><default>false</default><summary>Draw a soft shadow behind text</summary></key>
    <key name="show-header" type="b"><default>true</default><summary>Show the NETWORK title and status dot</summary></key>

    <!-- Rows -->
    <key name="show-wifi" type="b"><default>true</default><summary>Show Wi-Fi / Ethernet</summary></key>
    <key name="show-link" type="b"><default>true</default><summary>Show link speed</summary></key>
    <key name="show-local-ip" type="b"><default>true</default><summary>Show local IP</summary></key>
    <key name="show-gateway" type="b"><default>true</default><summary>Show gateway</summary></key>
    <key name="show-public-ip" type="b"><default>true</default><summary>Show public IP</summary></key>
    <key name="show-location" type="b"><default>true</default><summary>Show approximate location</summary></key>
    <key name="show-proxy" type="b"><default>true</default><summary>Show proxy</summary></key>
    <key name="show-vpn" type="b"><default>true</default><summary>Show VPN</summary></key>
    <key name="show-tailscale" type="b"><default>true</default><summary>Show Tailscale profile, IP and exit node</summary></key>

    <!-- Behaviour -->
    <key name="click-to-copy" type="b"><default>true</default><summary>Click a value to copy it</summary></key>
    <key name="lock-position" type="b"><default>false</default><summary>Disable dragging</summary></key>
    <key name="lookup-public-ip" type="b"><default>true</default><summary>Look up public IP and location online</summary></key>
    <key name="local-refresh-seconds" type="i">
      <range min="10" max="600"/>
      <default>30</default>
      <summary>Local info refresh interval (seconds)</summary>
    </key>
    <key name="remote-refresh-minutes" type="i">
      <range min="1" max="120"/>
      <default>5</default>
      <summary>Public IP refresh interval (minutes)</summary>
    </key>

    <!-- Position (fractions of the primary monitor; -1 = default spot) -->
    <key name="x-percent" type="d"><default>-1.0</default><summary>Horizontal position</summary></key>
    <key name="y-percent" type="d"><default>-1.0</default><summary>Vertical position</summary></key>
  </schema>
</schemalist>
